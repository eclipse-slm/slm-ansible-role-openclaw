# Managed by Ansible - manual changes will be overwritten
[Unit]
Description=oauth2-proxy for the OpenClaw gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oauth2-proxy
Group=oauth2-proxy
ExecStart={{ __slm_ansible_role_openclaw_oauth2_proxy_bin }} --config={{ __slm_ansible_role_openclaw_oauth2_proxy_conf_dir }}/oauth2-proxy.cfg
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
